# AutoCare environment variables — copy to .env and fill in real values
DATABASE_URL="postgresql://autocare:autocare_dev@localhost:5432/autocare"
# Max DB connections in the app pool (node-postgres default is 10). Lower it
# when behind a pooler like pgbouncer/Supabase (e.g. 5), raise it for direct
# Postgres on a single long-lived server (e.g. 20-50).
DATABASE_POOL_SIZE="20"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Number of trusted reverse proxies in front of the app. Used to pick the real
# client IP from X-Forwarded-For for rate limiting. 0 = single trusted proxy
# (take the rightmost entry). Increase by 1 for each extra internal proxy hop.
TRUSTED_PROXY_COUNT="0"
# Distributed rate-limit store. When set, rate limits are enforced across all
# instances via Redis; when empty, an in-memory per-process store is used
# (fine for local dev, NOT for multi-instance / serverless deployments).
REDIS_URL="redis://localhost:6379"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
E2E_CUSTOMER_EMAIL=""
E2E_CUSTOMER_PASSWORD=""
E2E_MANAGER_EMAIL=""
E2E_RECEPTIONIST_EMAIL=""
E2E_STAFF_PASSWORD=""
E2E_TECHNICIAN_EMAIL=""
E2E_CASHIER_EMAIL=""
# VNPay sandbox — đăng ký tại https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn"
# DEV ONLY — set NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS="1" (and optionally a demo
# password) in .env.development.local to show the demo quick-login panel on the
# login page. NEVER enable in production: it exposes seeded staff credentials.
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=""
NEXT_PUBLIC_DEMO_PASSWORD=""
