// AutoCare — Prisma schema
// Money: all amounts are stored as Int in VND (đồng, no sub-unit).
// Multi-tenant readiness: every garage-owned table carries garageId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  PLATFORM_ADMIN
  STAFF
}

enum GarageRole {
  RECEPTIONIST
  TECHNICIAN
  CASHIER
  GARAGE_MANAGER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RepairOrderStatus {
  RECEIVED
  INSPECTING
  WAITING_CUSTOMER_APPROVAL
  WAITING_PARTS
  IN_PROGRESS
  QUALITY_CHECK
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum QuotationItemStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CLARIFICATION
}

enum QuotationItemType {
  SERVICE
  PART
  OTHER
}

enum WorkTaskStatus {
  NOT_STARTED
  WAITING_PARTS
  IN_PROGRESS
  PAUSED
  WAITING_APPROVAL
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentType {
  DEPOSIT
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum InventoryTxType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  RETURN
}

enum InspectionSeverity {
  OK
  ATTENTION
  URGENT
}

enum TimelineEventType {
  MAINTENANCE
  REPAIR
  INSPECTION
  PART_REPLACEMENT
  ACCIDENT
  RESCUE
  REGISTRATION
  INSURANCE
  OIL_CHANGE
  TIRE_CHANGE
  BATTERY_CHANGE
  MILEAGE_UPDATE
  OWNERSHIP_TRANSFER
}

enum RecordSource {
  VERIFIED_GARAGE_RECORD
  OWNER_PROVIDED_RECORD
  IMPORTED_RECORD
}

enum VehicleSystem {
  ENGINE
  TRANSMISSION
  BRAKES
  SUSPENSION
  STEERING
  ELECTRICAL
  BATTERY
  TIRES
  AIR_CONDITIONING
  BODY
}

enum SystemCondition {
  GOOD
  FAIR
  POOR
  UNKNOWN
}

enum MediaKind {
  IMAGE
  DOCUMENT
}

enum MediaPhase {
  RECEPTION
  INSPECTION
  BEFORE_REPAIR
  AFTER_REPAIR
  DELIVERY
  OTHER
}

enum NotificationType {
  APPOINTMENT
  QUOTATION
  REPAIR_PROGRESS
  INVOICE
  MAINTENANCE_REMINDER
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         GarageMember[]
  customerProfiles    Customer[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  assignedWorkTasks   WorkTask[]     @relation("AssignedTasks")
  advisedRepairOrders RepairOrder[]  @relation("RepairOrderAdvisor")
  workLogs            WorkLog[]

  @@map("users")
}

model Garage {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  /// Garage-level settings, e.g. { "allowNegativeStock": false }
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               GarageMember[]
  customers             Customer[]
  appointments          Appointment[]
  repairOrders          RepairOrder[]
  repairOrderSequences  RepairOrderSequence[]
  services              Service[]
  parts                 Part[]
  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]
  payments              Payment[]
  auditLogs             AuditLog[]

  @@map("garages")
}

model GarageMember {
  id        String     @id @default(cuid())
  garageId  String
  userId    String
  role      GarageRole
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  garage Garage @relation(fields: [garageId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([garageId, userId])
  @@index([userId])
  @@map("garage_members")
}

// ---------------------------------------------------------------------------
// Customers & vehicles
// ---------------------------------------------------------------------------

model Customer {
  id        String    @id @default(cuid())
  garageId  String
  /// Optional link to a portal user account.
  userId    String?
  name      String
  phone     String
  email     String?
  address   String?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  garage       Garage             @relation(fields: [garageId], references: [id])
  user         User?              @relation(fields: [userId], references: [id])
  ownerships   VehicleOwnership[]
  appointments Appointment[]
  repairOrders RepairOrder[]
  invoices     Invoice[]

  @@unique([garageId, phone])
  @@index([garageId, name])
  @@index([userId])
  @@map("customers")
}

model Vehicle {
  id           String    @id @default(cuid())
  /// VIN / số khung — stable identifier when available.
  vin          String?   @unique
  licensePlate String
  brand        String
  model        String
  year         Int?
  color        String?
  engineNumber String?
  /// Latest known odometer value (km), denormalized from MileageLog.
  currentKm    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  ownerships     VehicleOwnership[]
  appointments   Appointment[]
  repairOrders   RepairOrder[]
  mileageLogs    MileageLog[]
  timelineEvents VehicleTimelineEvent[]
  maintenance    MaintenanceRecord[]
  warranties     Warranty[]
  systemStatuses VehicleSystemStatus[]
  shareLinks     ShareLink[]
  media          Media[]

  @@index([licensePlate])
  @@map("vehicles")
}

model VehicleOwnership {
  id         String    @id @default(cuid())
  vehicleId  String
  customerId String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  isCurrent  Boolean   @default(true)
  note       String?
  createdAt  DateTime  @default(now())

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([vehicleId, isCurrent])
  @@index([customerId])
  @@map("vehicle_ownerships")
}

model MileageLog {
  id             String       @id @default(cuid())
  vehicleId      String
  garageId       String?
  mileageKm      Int
  recordedAt     DateTime     @default(now())
  source         RecordSource @default(VERIFIED_GARAGE_RECORD)
  note           String?
  /// Set when a manager overrides the "never decreases" rule.
  overrideReason String?
  createdById    String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, recordedAt])
  @@map("mileage_logs")
}

// ---------------------------------------------------------------------------
// Appointments & repair orders
// ---------------------------------------------------------------------------

model Appointment {
  id             String            @id @default(cuid())
  garageId       String
  customerId     String
  vehicleId      String
  status         AppointmentStatus @default(PENDING)
  scheduledAt    DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  serviceRequest String?
  note           String?
  createdById    String?
  confirmedById  String?
  cancelledById  String?
  cancelReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  garage      Garage       @relation(fields: [garageId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  repairOrder RepairOrder?

  @@index([garageId, scheduledAt])
  @@index([garageId, status])
  @@index([vehicleId, status])
  @@map("appointments")
}

model RepairOrder {
  id              String            @id @default(cuid())
  garageId        String
  /// Human-readable code, unique per garage, e.g. RO-2026-0001.
  code            String
  vehicleId       String
  customerId      String
  appointmentId   String?           @unique
  status          RepairOrderStatus @default(RECEIVED)
  receivedAt      DateTime          @default(now())
  mileageKm       Int?
  /// Fuel level 0–100 (%).
  fuelLevel       Int?
  initialNote     String?
  intakeChecklist Json?
  advisorId       String?
  version         Int               @default(1)
  completedAt     DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  garage      Garage       @relation(fields: [garageId], references: [id])
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  advisor     User?        @relation("RepairOrderAdvisor", fields: [advisorId], references: [id])
  inspections Inspection[]
  quotations  Quotation[]
  workTasks   WorkTask[]
  invoices    Invoice[]
  media       Media[]

  @@unique([garageId, code])
  @@index([garageId, status])
  @@index([garageId, createdAt])
  @@index([vehicleId])
  @@map("repair_orders")
}

model RepairOrderSequence {
  id        String @id @default(cuid())
  garageId  String
  year      Int
  nextValue Int    @default(1)

  garage Garage @relation(fields: [garageId], references: [id])

  @@unique([garageId, year])
  @@map("repair_order_sequences")
}

// ---------------------------------------------------------------------------
// Inspection
// ---------------------------------------------------------------------------

model Inspection {
  id            String    @id @default(cuid())
  garageId      String
  repairOrderId String    @unique
  inspectorId   String?
  summary       String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  repairOrder RepairOrder      @relation(fields: [repairOrderId], references: [id])
  items       InspectionItem[]

  @@index([garageId])
  @@map("inspections")
}

model InspectionItem {
  id             String             @id @default(cuid())
  inspectionId   String
  category       String
  name           String
  severity       InspectionSeverity @default(OK)
  finding        String?
  recommendation String?
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id])
  media      Media[]

  @@index([inspectionId])
  @@map("inspection_items")
}

// ---------------------------------------------------------------------------
// Quotations
// ---------------------------------------------------------------------------

model Quotation {
  id              String          @id @default(cuid())
  garageId        String
  repairOrderId   String
  /// Version number within the repair order (1, 2, ...).
  versionNo       Int             @default(1)
  status          QuotationStatus @default(DRAFT)
  isSupplementary Boolean         @default(false)
  parentQuotationId String?
  note            String?
  validUntil      DateTime?
  sentAt          DateTime?
  decidedAt       DateTime?
  /// Sum of item totals (VND).
  totalAmount     Int             @default(0)
  supersededById  String?         @unique
  version         Int             @default(1)
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  repairOrder  RepairOrder     @relation(fields: [repairOrderId], references: [id])
  supersededBy Quotation?      @relation("QuotationSupersession", fields: [supersededById], references: [id])
  supersedes   Quotation?      @relation("QuotationSupersession")
  parentQuotation Quotation?   @relation("SupplementaryQuotation", fields: [parentQuotationId], references: [id])
  supplementaryQuotations Quotation[] @relation("SupplementaryQuotation")
  items        QuotationItem[]

  @@unique([repairOrderId, versionNo])
  @@index([garageId, status])
  @@index([parentQuotationId])
  @@map("quotations")
}

model QuotationItem {
  id             String              @id @default(cuid())
  quotationId    String
  type           QuotationItemType   @default(SERVICE)
  serviceId      String?
  partId         String?
  description    String
  quantity       Int                 @default(1)
  /// Unit price in VND.
  unitPrice      Int
  /// Absolute discount in VND applied to the line.
  discountAmount Int                 @default(0)
  /// quantity * unitPrice - discountAmount (VND).
  totalAmount    Int
  status         QuotationItemStatus @default(PENDING)
  customerNote   String?
  decidedAt      DateTime?
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  quotation Quotation  @relation(fields: [quotationId], references: [id])
  service   Service?   @relation(fields: [serviceId], references: [id])
  part      Part?      @relation(fields: [partId], references: [id])
  workTasks WorkTask[]

  @@index([quotationId])
  @@map("quotation_items")
}

// ---------------------------------------------------------------------------
// Work management
// ---------------------------------------------------------------------------

model WorkTask {
  id               String         @id @default(cuid())
  garageId         String
  repairOrderId    String
  quotationItemId  String?
  title            String
  description      String?
  status           WorkTaskStatus @default(NOT_STARTED)
  assignedToId     String?
  estimatedMinutes Int?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  repairOrder           RepairOrder            @relation(fields: [repairOrderId], references: [id])
  quotationItem         QuotationItem?         @relation(fields: [quotationItemId], references: [id])
  assignedTo            User?                  @relation("AssignedTasks", fields: [assignedToId], references: [id])
  workLogs              WorkLog[]
  inventoryTransactions InventoryTransaction[]

  @@index([garageId, status])
  @@index([repairOrderId])
  @@index([assignedToId])
  @@map("work_tasks")
}

model WorkLog {
  id           String   @id @default(cuid())
  workTaskId   String
  userId       String
  note         String
  minutesSpent Int?
  createdAt    DateTime @default(now())

  workTask WorkTask @relation(fields: [workTaskId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([workTaskId])
  @@map("work_logs")
}

// ---------------------------------------------------------------------------
// Services, parts & inventory
// ---------------------------------------------------------------------------

model Service {
  id               String   @id @default(cuid())
  garageId         String
  name             String
  description      String?
  /// Base price in VND.
  basePrice        Int
  estimatedMinutes Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  garage         Garage          @relation(fields: [garageId], references: [id])
  quotationItems QuotationItem[]

  @@index([garageId, isActive])
  @@map("services")
}

model Part {
  id                String   @id @default(cuid())
  garageId          String
  sku               String
  name              String
  unit              String   @default("cái")
  /// Purchase cost in VND.
  costPrice         Int      @default(0)
  /// Selling price in VND.
  sellPrice         Int      @default(0)
  quantityInStock   Int      @default(0)
  lowStockThreshold Int      @default(0)
  isActive          Boolean  @default(true)
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  garage                Garage                 @relation(fields: [garageId], references: [id])
  quotationItems        QuotationItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([garageId, sku])
  @@index([garageId, isActive])
  @@map("parts")
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  garageId      String
  partId        String
  type          InventoryTxType
  /// Signed quantity: positive for RECEIPT/RETURN/positive ADJUSTMENT, negative for ISSUE.
  quantity      Int
  /// Unit cost in VND at transaction time (for receipts).
  unitCost      Int?
  reason        String?
  repairOrderId String?
  workTaskId    String?
  createdById   String?
  createdAt     DateTime        @default(now())

  garage   Garage    @relation(fields: [garageId], references: [id])
  part     Part      @relation(fields: [partId], references: [id])
  workTask WorkTask? @relation(fields: [workTaskId], references: [id])

  @@index([garageId, partId])
  @@index([repairOrderId])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Invoices & payments
// ---------------------------------------------------------------------------

model Invoice {
  id             String        @id @default(cuid())
  garageId       String
  /// Human-readable code, unique per garage, e.g. INV-2026-0001.
  code           String
  repairOrderId  String?
  customerId     String
  status         InvoiceStatus @default(DRAFT)
  /// All amounts in VND.
  subtotal       Int           @default(0)
  discountAmount Int           @default(0)
  taxAmount      Int           @default(0)
  totalAmount    Int           @default(0)
  paidAmount     Int           @default(0)
  issuedAt       DateTime?
  dueAt          DateTime?
  cancelledAt    DateTime?
  version        Int           @default(1)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  garage      Garage        @relation(fields: [garageId], references: [id])
  repairOrder RepairOrder?  @relation(fields: [repairOrderId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  @@unique([garageId, code])
  @@index([garageId, status])
  @@index([garageId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id                    String  @id @default(cuid())
  invoiceId             String
  description           String
  quantity              Int     @default(1)
  unitPrice             Int
  discountAmount        Int     @default(0)
  totalAmount           Int
  sourceQuotationItemId String?
  sortOrder             Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id           String        @id @default(cuid())
  garageId     String
  invoiceId    String
  type         PaymentType   @default(PAYMENT)
  method       PaymentMethod @default(CASH)
  /// Amount in VND, always positive; `type` distinguishes refunds.
  amount       Int
  paidAt       DateTime      @default(now())
  reference    String?
  note         String?
  receivedById String?
  createdAt    DateTime      @default(now())

  garage  Garage  @relation(fields: [garageId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([garageId, paidAt])
  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Vehicle health record
// ---------------------------------------------------------------------------

model VehicleTimelineEvent {
  id            String            @id @default(cuid())
  vehicleId     String
  garageId      String?
  type          TimelineEventType
  source        RecordSource      @default(VERIFIED_GARAGE_RECORD)
  title         String
  description   String?
  occurredAt    DateTime
  mileageKm     Int?
  repairOrderId String?
  /// Extra structured payload for the event.
  data          Json?
  createdById   String?
  createdAt     DateTime          @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, occurredAt])
  @@map("vehicle_timeline_events")
}

model MaintenanceRecord {
  id               String       @id @default(cuid())
  vehicleId        String
  garageId         String?
  repairOrderId    String?
  title            String
  description      String?
  performedAt      DateTime
  mileageKm        Int?
  nextDueDate      DateTime?
  nextDueMileageKm Int?
  source           RecordSource @default(VERIFIED_GARAGE_RECORD)
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, performedAt])
  @@map("maintenance_records")
}

model Warranty {
  id              String    @id @default(cuid())
  vehicleId       String
  garageId        String?
  repairOrderId   String?
  quotationItemId String?
  name            String
  terms           String?
  startsAt        DateTime
  expiresAt       DateTime?
  mileageLimitKm  Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, isActive])
  @@map("warranties")
}

model VehicleSystemStatus {
  id            String          @id @default(cuid())
  vehicleId     String
  system        VehicleSystem
  condition     SystemCondition @default(UNKNOWN)
  note          String?
  lastCheckedAt DateTime?
  updatedAt     DateTime        @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, system])
  @@map("vehicle_system_statuses")
}

model ShareLink {
  id          String    @id @default(cuid())
  vehicleId   String
  token       String    @unique
  /// Options, e.g. { "showOwner": false, "showInvoices": false }.
  scope       Json      @default("{}")
  expiresAt   DateTime?
  revokedAt   DateTime?
  viewCount   Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("share_links")
}

// ---------------------------------------------------------------------------
// Media, notifications, audit
// ---------------------------------------------------------------------------

model Media {
  id               String     @id @default(cuid())
  garageId         String?
  vehicleId        String?
  repairOrderId    String?
  inspectionItemId String?
  kind             MediaKind  @default(IMAGE)
  phase            MediaPhase @default(OTHER)
  /// Storage-provider key (see storage abstraction).
  storageKey       String     @unique
  mimeType         String
  sizeBytes        Int
  caption          String?
  uploadedById     String?
  createdAt        DateTime   @default(now())

  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  repairOrder    RepairOrder?    @relation(fields: [repairOrderId], references: [id])
  inspectionItem InspectionItem? @relation(fields: [inspectionItemId], references: [id])

  @@index([repairOrderId])
  @@index([vehicleId])
  @@map("media")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  garageId  String?
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  /// Deep-link payload, e.g. { "href": "/portal/quotations/..." }.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  garageId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  /// Snapshot before the change (redacted of secrets).
  before      Json?
  /// Snapshot after the change (redacted of secrets).
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id])
  actor  User?   @relation(fields: [actorUserId], references: [id])

  @@index([garageId, entityType, entityId])
  @@index([garageId, createdAt])
  @@map("audit_logs")
}
